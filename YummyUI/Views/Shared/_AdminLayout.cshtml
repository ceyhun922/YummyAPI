<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta content="width=device-width, initial-scale=1, maximum-scale=1, shrink-to-fit=no" name="viewport">
  <title>ADMİN</title>

  <!-- General CSS Files -->
  <link rel="stylesheet" href="~/Admin/assets/css/app.min.css">
  <link rel="stylesheet" href="~/Admin/assets/css/style.css">
  <link rel="stylesheet" href="~/Admin/assets/css/components.css">
  <link rel="stylesheet" href="~/Admin/assets/css/custom.css">
  <link rel="stylesheet" href="~/Admin/assets/css/ui.premium.css">
  <link rel='shortcut icon' type='image/x-icon' href='~/Admin/assets/img/favicon.ico' />
  <link rel="preconnect" href="https://loremflickr.com" crossorigin>
<link rel="dns-prefetch" href="https://loremflickr.com">
<link rel="preconnect" href="https://flagcdn.com" crossorigin>
<link rel="dns-prefetch" href="https://flagcdn.com">


  <!-- Bootstrap Icons (ikonlar için şart) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  

  <!-- SweetAlert2 (tek kez) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

  

  @RenderSection("Styles", false)

</head>

<body class="ai-admin">

  <div class="loader"></div>
  <div id="app">
    <div class="main-wrapper main-wrapper-1">


      <div class="main-sidebar sidebar-style-2">
        @await Component.InvokeAsync("_AdminSideBarComponentPartilas")
      </div>

      <div class="main-content">
        <section class="section">
          <div class="section-body">
            @RenderBody()
          </div>
        </section>
      </div>

      <footer class="main-footer">
        <div class="footer-left">
          <a href="templateshub.net">Templateshub</a>
        </div>
        <div class="footer-right"></div>
      </footer>
    </div>
  </div>

  <!-- General JS Scripts -->
  <script src="~/Admin/assets/js/app.min.js"></script>
  <script src="~/Admin/assets/js/scripts.js"></script>
  <script src="~/Admin/assets/js/custom.js"></script>
    <script src="~/Admin/assets/bundles/apexcharts/apexcharts.min.js"></script>
  <script src="~/Admin/assets/js/page/index.js"></script>


  <!-- SweetAlert2 JS (tek kez) -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  @RenderSection("Scripts", false);
</body>
</html>
