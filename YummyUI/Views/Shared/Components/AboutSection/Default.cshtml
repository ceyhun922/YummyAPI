@using YummyAPI.DTOs.AboutDTO
@model List<ResultAboutDto>

@{
    var first = Model?.FirstOrDefault();
    var apiBase = "http://localhost:5289";
}

@if (first != null)
{
  <section id="about" class="about section">

      <!-- Section Title -->
      <div class="container section-title" data-aos="fade-up">
        <h2>Hakkımızda<br></h2>
        <p><span>Hakkımızda Daha Fazla</span> <span class="description-title"> Bilgi Edinin</span></p>
      </div>

      <div class="container">

        <div class="row gy-4">
          <div class="col-lg-7" data-aos="fade-up" data-aos-delay="100">
            <img src="@(apiBase + first.AboutImageUrl)" class="img-fluid mb-4" alt="">
            <div class="book-a-table">
              <h3>Masa Ayırt</h3>
              <p>+1 5589 55488 55</p>
            </div>
          </div>
          <div class="col-lg-5" data-aos="fade-up" data-aos-delay="250">
            <div class="content ps-0 ps-lg-5">
              <p class="fst-italic">
              @first.AboutSubTitle
              </p>
              <ul>
                <li><i class="bi bi-check-circle-fill"></i> <span>@first.AboutTitleChecked1.</span></li>
                <li><i class="bi bi-check-circle-fill"></i> <span>@first.AboutTitleChecked2</span></li>
                <li><i class="bi bi-check-circle-fill"></i> <span>@first.AboutTitleChecked3.</span></li>
              </ul>
              <p>
                @first.AboutDesciription
              </p>

              <div class="position-relative mt-4">
                <img src="@(apiBase + first.AboutImageUrl)" class="img-fluid" alt="">
                <a href="@first.AboutVideoUrl" class="glightbox pulsating-play-btn"></a>
              </div>
            </div>
          </div>
        </div>

      </div>

    </section>
}
