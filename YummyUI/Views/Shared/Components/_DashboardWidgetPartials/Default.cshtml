@using YummyUI.DTOs.DashboardDtos
@model DashboardWidgetDto
@{
    var data =Model;
}
<div class="row">

  <!-- Bugünkü Organizasyon -->
  <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 col-xs-12">
    <div class="card">
      <div class="card-statistic-4">
        <div class="row">
          <div class="col-6 pr-0 pt-3">
            <div class="card-content">
              <h5 class="font-15">Bugünkü Organizasyon</h5>
              <h2 class="mb-3 font-18">@data.TodayOrg</h2>
            </div>
          </div>
          <div class="col-6 pl-0">
            <div class="banner-img">
              <img src="/Admin/assets/img/banner/1.png" alt="">
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Yaklaşan Organizasyon -->
  <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 col-xs-12">
    <div class="card">
      <div class="card-statistic-4">
        <div class="row">
          <div class="col-6 pr-0 pt-3">
            <div class="card-content">
              <h5 class="font-15">Yaklaşan Organizasyon</h5>
              <h2 class="mb-3 font-18">@data.UncomingOrg</h2>
            </div>
          </div>
          <div class="col-6 pl-0">
            <div class="banner-img">
              <img src="/Admin/assets/img/banner/2.png" alt="">
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Okunmamış Mesaj -->
  <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 col-xs-12">
    <div class="card">
      <div class="card-statistic-4">
        <div class="row">
          <div class="col-6 pr-0 pt-3">
            <div class="card-content">
              <h5 class="font-15">Okunmamış Mesaj</h5>
              <h2 class="mb-3 font-18">@data.UnreadMsg</h2>
              <p class="mb-0"><a href="#" class="col-red">Aksiyon gerekli</a></p>
            </div>
          </div>
          <div class="col-6 pl-0">
            <div class="banner-img">
              <img src="/Admin/assets/img/banner/3.png" alt="">
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bekleyen İşlem -->
  <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 col-xs-12">
    <div class="card">
      <div class="card-statistic-4">
        <div class="row">
          <div class="col-6 pr-0 pt-3">
            <div class="card-content">
              <h5 class="font-15">Bekleyen Rezervasyon</h5>
              <h2 class="mb-3 font-18">@data.PendingRez</h2>
              <p class="mb-0"><a class="col-orange" href="#">Kontrol et</a></p>
            </div>
          </div>
          <div class="col-6 pl-0">
            <div class="banner-img">
              <img src="/Admin/assets/img/banner/4.png" alt="">
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

</div>