@using System.ComponentModel
@using YummyUI.DTOs.FooterDTOs
  @model List<ResultFooterDto>
  <!-- Section Title -->
  <div class="container section-title" data-aos="fade-up">
    <h2>İletişim</h2>
    <p><span>Yardıma mı</span> <span class="description-title">İhtiyacınız var ?</span></p>
  </div><!-- End Section Title -->
    @{
       var first = Model.FirstOrDefault();
    }

@if(first != null)
{
  <div class="container" data-aos="fade-up" data-aos-delay="100">

    <div class="mb-5">
      <iframe style="width: 100%; height: 400px;"
        src="@first.MapLocation"
        src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d12097.433213460943!2d-74.0062269!3d40.7101282!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0xb89d1fe6bc499443!2sDowntown+Conference+Center!5e0!3m2!1smk!2sbg!4v1539943755621"
        frameborder="0" allowfullscreen=""></iframe>
    </div><!-- End Google Maps -->

    <div class="row gy-4">

      <div class="col-md-6">
        <div class="info-item d-flex align-items-center" data-aos="fade-up" data-aos-delay="200">
          <i class="icon bi bi-geo-alt flex-shrink-0"></i>
          <div>
            <h3>Adresimiz</h3>
            <p>@first.Address</p>
          </div>
        </div>
      </div><!-- End Info Item -->

      <div class="col-md-6">
        <div class="info-item d-flex align-items-center" data-aos="fade-up" data-aos-delay="300">
          <i class="icon bi bi-telephone flex-shrink-0"></i>
          <div>
            <h3>Telefon</h3>
            <p>@first.CallUs</p>
          </div>
        </div>
      </div><!-- End Info Item -->

      <div class="col-md-6">
        <div class="info-item d-flex align-items-center" data-aos="fade-up" data-aos-delay="400">
          <i class="icon bi bi-envelope flex-shrink-0"></i>
          <div>
            <h3>E-mail</h3>
            <p>@first.EmailUs</p>
          </div>
        </div>
      </div><!-- End Info Item -->

      <div class="col-md-6">
        <div class="info-item d-flex align-items-center" data-aos="fade-up" data-aos-delay="500">
          <i class="icon bi bi-clock flex-shrink-0"></i>
          <div>
            <h3>Çalışma Saatlerimiz<br></h3>
            <p><strong> @first.OpeningHours </strong></p>
          </div>
        </div>
      </div><!-- End Info Item -->

    </div>
     @await Component.InvokeAsync("_ContactFormPartials");
      </div>

}

