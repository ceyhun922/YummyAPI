@using YummyUI.DTOs.TestimonialDTOs
@model GetByIdTestimonialDto

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Müşteri Görüşü Güncelle";

    var apiBase = "http://localhost:5289";
    var existingImg = Model?.TestimonialImageUrl ?? "";
    if (!string.IsNullOrWhiteSpace(existingImg) && existingImg.StartsWith("/images/"))
        existingImg = apiBase + existingImg;
}

<div class="admin-create-page">

    <div class="page-hero">
        <div class="hero-left">
            <div class="hero-icon">
                <i class="fas fa-pen-to-square"></i>
            </div>
            <div>
                <h1 class="hero-title">Müşteri Görüşü Güncelle</h1>
                <p class="hero-subtitle">Başlık, mesaj, görsel ve durumu güncelleyin.</p>
            </div>
        </div>

        <div class="hero-right">
            <span class="status-pill @(Model.TestimonialStatus ? "is-active" : "is-passive")" id="heroStatusPill">
                <span class="dot"></span>
                <span id="heroStatusText">@(Model.TestimonialStatus ? "Aktif" : "Pasif")</span>
            </span>
        </div>
    </div>

    <div class="grid-2">
        <div class="glass-card">
            <div class="glass-card-header">
                <h3>Görüş Güncelleme Paneli</h3>
            </div>

            <div class="glass-card-body">
                @using (Html.BeginForm("UpdateTestimonial", "Testimonial", FormMethod.Post,
                    new { enctype = "multipart/form-data", @class = "glass-form", autocomplete = "off" }))
                {
                    @Html.HiddenFor(x => x.TestimonialId)

                    <input type="hidden" id="existingImg" name="TestimonialImageUrl" value="@existingImg" />

                    <div class="form-row">
                        <label class="form-label">Müşteri Adı</label>
                        @Html.TextBoxFor(x => x.TestimonialName, new { @class = "glass-input", id = "inpName" })
                    </div>

                    <div class="form-row">
                        <label class="form-label">Ünvan / Başlık</label>
                        @Html.TextBoxFor(x => x.TestimonialTitle, new { @class = "glass-input", id = "inpTitle" })
                    </div>

                    <div class="form-row">
                        <label class="form-label">Mesaj</label>
                        @Html.TextAreaFor(x => x.TestimonialMessage, new { @class = "glass-textarea", rows = 5, id = "inpMsg" })
                    </div>

                    <div class="form-row">
                        <label class="form-label">Görsel (Sadece Dosya)</label>
                        <input type="file"
                               name="file"
                               id="inpImgFile"
                               class="glass-input"
                               accept=".jpg,.jpeg,.png,.webp" />
                        <small class="form-hint">
                            Dosya seçmezseniz mevcut görsel korunur.
                        </small>
                    </div>

                    <div class="form-row form-row-inline">
                        <label class="form-label">Durum</label>
                        <label class="switch">
                            @Html.CheckBoxFor(x => x.TestimonialStatus, new { id = "inpStatus" })
                            <span class="slider"></span>
                        </label>
                    </div>

                    <div class="form-actions">
                        <button class="btn-primary" type="submit">
                            <i class="fas fa-save"></i> Güncelle
                        </button>
                        <a href="/Testimonial/TestimonialList" class="btn-secondary">
                            <i class="fas fa-arrow-left"></i> Geri Dön
                        </a>
                    </div>
                }
            </div>
        </div>

        <div class="glass-card">
            <div class="glass-card-header">
                <h3>Canlı Önizleme</h3>
            </div>

            <div class="glass-card-body">
                <div class="preview-card">

                    <div class="preview-top">
                        <div class="preview-avatar"><i class="fas fa-user"></i></div>

                        <div class="preview-meta">
                            <div class="preview-title" id="prevName"></div>
                            <div class="preview-subtitle" id="prevTitle"></div>
                        </div>

                        <span class="status-pill small" id="prevStatus">
                            <span class="dot"></span>
                        </span>
                    </div>

                    <div class="preview-image">
                        <img id="prevImage"
                             src="@existingImg"
                             style="@(string.IsNullOrEmpty(existingImg) ? "display:none" : "display:block")" />

                        <div id="prevImgPh"
                             class="preview-image-placeholder"
                             style="@(string.IsNullOrEmpty(existingImg) ? "display:flex" : "display:none")">
                            Görsel önizlemesi
                        </div>
                    </div>

                    <div class="preview-message" id="prevMsg"></div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    const $ = id => document.getElementById(id);
    const API_BASE = "http://localhost:5289";

    const elName = $("inpName");
    const elTitle = $("inpTitle");
    const elMsg = $("inpMsg");
    const elFile = $("inpImgFile");
    const elStatus = $("inpStatus");

    const prevName = $("prevName");
    const prevTitle = $("prevTitle");
    const prevMsg = $("prevMsg");
    const prevImg = $("prevImage");
    const prevPh = $("prevImgPh");
    const prevStatus = $("prevStatus");
    const heroPill = $("heroStatusPill");
    const heroText = $("heroStatusText");

    let lastUrl = null;

    function syncText() {
        prevName.textContent = elName.value || "Başlık";
        prevTitle.textContent = elTitle.value || "Alt Başlık";
        prevMsg.textContent = elMsg.value || "Mesaj içeriği";
    }

    function syncStatus() {
        const on = elStatus.checked;
        prevStatus.className = `status-pill small ${on ? "is-active" : "is-passive"}`;
        prevStatus.innerHTML = `<span class="dot"></span> ${on ? "Aktif" : "Pasif"}`;
        heroPill.className = `status-pill ${on ? "is-active" : "is-passive"}`;
        heroText.textContent = on ? "Aktif" : "Pasif";
    }

    function normalizeToFullUrl(pathOrUrl) {
        const v = (pathOrUrl || "").trim();
        if (!v) return "";
        if (v.startsWith("http://") || v.startsWith("https://")) return v;
        if (v.startsWith("/")) return API_BASE + v;
        return API_BASE + "/" + v;
    }

    function syncImageFromFile() {
        const f = elFile.files[0];
        if (!f) return;

        if (lastUrl) URL.revokeObjectURL(lastUrl);
        lastUrl = URL.createObjectURL(f);

        prevImg.src = lastUrl;
        prevImg.style.display = "block";
        prevPh.style.display = "none";
    }

    function showExistingIfAny() {
        const existing = normalizeToFullUrl($("existingImg")?.value);

        if (!existing) {
            prevImg.style.display = "none";
            prevPh.style.display = "flex";
            return;
        }

        prevImg.onload = () => { prevImg.style.display = "block"; prevPh.style.display = "none"; };
        prevImg.onerror = () => { prevImg.style.display = "none"; prevPh.style.display = "flex"; };

        prevImg.src = existing;
    }

    ["input","change"].forEach(e=>{
        elName.addEventListener(e, syncText);
        elTitle.addEventListener(e, syncText);
        elMsg.addEventListener(e, syncText);
        elStatus.addEventListener(e, syncStatus);
    });

    elFile.addEventListener("change", syncImageFromFile);

    syncText();
    syncStatus();
    showExistingIfAny();
})();
</script>
}
