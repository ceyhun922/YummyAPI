@using YummyUI.DTOs.ChefDTOs
@model GetByIdChefDto

@{
    ViewData["Title"] = "Şef • Update";
    Layout = "_AdminLayout";

    var apiBase = "http://localhost:5289";

    var currentImg = Model?.ImageFile ?? "";
    if (!string.IsNullOrWhiteSpace(currentImg) && currentImg.StartsWith("/images/"))
        currentImg = apiBase + currentImg;
}

@section Styles {
<style>
#chefUpdate{
  --bg0:#050814; --bg1:#070b1f;
  --glass: rgba(255,255,255,.08);
  --stroke: rgba(255,255,255,.14);
  --txt: rgba(255,255,255,.92);
  --muted: rgba(255,255,255,.65);
  --muted2: rgba(255,255,255,.45);
  --shadow: 0 18px 60px rgba(0,0,0,.45);
  --radius: 22px;
  --primary:#ffb020;
  --danger:#ff4d6d;
  --ok:#32d583;
  --chip: rgba(0,0,0,.18);

  min-height: calc(100vh - 60px);
  padding: 90px 22px 34px; /* üst bar fixed ise */
  color: var(--txt);
  background:
    radial-gradient(1200px 700px at 12% 18%, rgba(255,176,32,.14), transparent 55%),
    radial-gradient(900px 600px at 85% 20%, rgba(60,130,255,.18), transparent 60%),
    radial-gradient(900px 600px at 70% 85%, rgba(168,85,247,.22), transparent 55%),
    linear-gradient(180deg, var(--bg0), var(--bg1));
  position: relative;
  border-radius: 22px;
  overflow: visible; /* sticky bozulmasın */
}

#chefUpdate .cu-grid{
  position:absolute; inset:0;
  background-image:
    linear-gradient(to right, rgba(255,255,255,.06) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(255,255,255,.06) 1px, transparent 1px);
  background-size: 42px 42px;
  opacity: .18;
  pointer-events:none;
  mask-image: radial-gradient(circle at 40% 20%, black 30%, transparent 70%);
  z-index:0;
}

#chefUpdate .cu-orb{ position:absolute; border-radius:999px; opacity:.35; pointer-events:none; z-index:0; }
#chefUpdate .cu-orb.o1{ width:320px; height:320px; left:-120px; top:140px;
  background: radial-gradient(circle at 30% 30%, rgba(255,176,32,.55), rgba(255,176,32,.12), transparent 70%); }
#chefUpdate .cu-orb.o2{ width:420px; height:420px; right:-160px; top:60px;
  background: radial-gradient(circle at 30% 30%, rgba(59,130,246,.55), rgba(59,130,246,.12), transparent 70%); }
#chefUpdate .cu-orb.o3{ width:520px; height:520px; right:120px; bottom:-260px;
  background: radial-gradient(circle at 30% 30%, rgba(168,85,247,.55), rgba(168,85,247,.14), transparent 70%); }

/* Header */
#chefUpdate .cu-head{
  position: relative;
  z-index:2;
  display:flex; justify-content:space-between; align-items:flex-start;
  gap:14px; margin-bottom:18px;
}
#chefUpdate .cu-title{ margin:0 0 6px; font-size:28px; font-weight:950; letter-spacing:.2px; }
#chefUpdate .cu-sub{ margin:0; color:var(--muted); font-size:13.5px; }
#chefUpdate .cu-pill{
  display:inline-flex; align-items:center; gap:10px;
  padding:10px 14px; border-radius:999px;
  background: rgba(255,255,255,.08);
  border:1px solid rgba(255,255,255,.14);
  box-shadow:0 10px 30px rgba(0,0,0,.35);
  color:var(--muted); font-size:12.5px; white-space:nowrap;
}
#chefUpdate .cu-icon{
  width:36px; height:36px; border-radius:14px;
  display:grid; place-items:center;
  background: linear-gradient(135deg, rgba(99,102,241,.85), rgba(168,85,247,.75));
  border:1px solid rgba(255,255,255,.18);
  box-shadow: 0 14px 40px rgba(99,102,241,.25);
  font-size:18px;
}

/* Layout GRID — üst üste binme bitti */
#chefUpdate .cu-layout{
  position: relative;
  z-index:2;
  display:grid !important;
  grid-template-columns: minmax(0,1.05fr) minmax(0,.95fr) !important;
  gap:18px !important;
  align-items:start !important;
}
@@media (max-width:1100px){
  #chefUpdate .cu-layout{ grid-template-columns: 1fr !important; }
}

/* Card (AdminLayout .card ile çakışmaz) */
#chefUpdate .cu-card{
  background: var(--glass);
  border: 1px solid var(--stroke);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  overflow:hidden;
  width:100%;
  min-width:0;
  max-width:100%;
  float:none;
  position:relative;
}
#chefUpdate .cu-cardHead{
  padding:16px 18px;
  display:flex; align-items:center; justify-content:space-between;
  border-bottom:1px solid rgba(255,255,255,.10);
  background: linear-gradient(180deg, rgba(255,255,255,.06), transparent);
}
#chefUpdate .cu-cardTitle{
  margin:0;
  font-size:14px;
  letter-spacing:.3px;
  text-transform:uppercase;
  color: rgba(255,255,255,.85);
  font-weight:950;
}
#chefUpdate .cu-body{ padding:18px; }

/* Buttons */
#chefUpdate .cu-btn{
  border:1px solid rgba(255,255,255,.16);
  background: rgba(255,255,255,.08);
  color: rgba(255,255,255,.88);
  border-radius:14px;
  padding:10px 12px;
  font-weight:950;
  font-size:13px;
  cursor:pointer;
  transition:.15s ease;
  user-select:none;
  text-decoration:none;
  display:inline-flex;
  gap:8px;
  align-items:center;
}
#chefUpdate .cu-btn:hover{ transform: translateY(-1px); border-color: rgba(255,255,255,.24); }
#chefUpdate .cu-btnPrimary{
  background: linear-gradient(180deg, rgba(255,176,32,.95), rgba(255,176,32,.75));
  color: rgba(0,0,0,.82);
  border-color: rgba(255,176,32,.60);
}
#chefUpdate .cu-btnDanger{
  background: linear-gradient(180deg, rgba(255,77,109,.95), rgba(255,77,109,.70));
  color: rgba(0,0,0,.82);
  border-color: rgba(255,77,109,.60);
}
#chefUpdate .cu-btnGhost{
  background: rgba(0,0,0,.16);
  border-color: rgba(255,255,255,.14);
  color: rgba(255,255,255,.85);
}

/* Form */
#chefUpdate .cu-val{ color:#ff9aa9; margin: 0 0 10px 0; font-weight:850; font-size:13px; }
#chefUpdate .cu-field{ margin-bottom:12px; }
#chefUpdate .cu-label{ display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:7px; }
#chefUpdate .cu-label label{ margin:0; font-weight:950; font-size:12.5px; color: rgba(255,255,255,.82); }
#chefUpdate .cu-hint{ color: var(--muted2); font-size:12px; font-weight:800; }
#chefUpdate .cu-input{
  width:100%;
  border-radius:14px;
  border:1px solid rgba(255,255,255,.14);
  background: rgba(0,0,0,.18);
  color: rgba(255,255,255,.90);
  padding:12px 12px;
  outline:none;
  transition:.15s ease;
}
#chefUpdate .cu-input:focus{
  border-color: rgba(255,176,32,.55);
  box-shadow: 0 0 0 4px rgba(255,176,32,.12);
}
#chefUpdate textarea.cu-input{ min-height:110px; resize:vertical; }
#chefUpdate .cu-row{ display:grid; grid-template-columns: 1fr 1fr; gap:12px; }
@@media (max-width:600px){ #chefUpdate .cu-row{ grid-template-columns:1fr; } }

/* Toggle */
#chefUpdate .cu-toggle{
  display:flex; align-items:center; gap:10px;
  padding:10px 12px;
  border-radius:14px;
  border:1px solid rgba(255,255,255,.14);
  background: rgba(0,0,0,.16);
}
#chefUpdate .cu-switch{
  width:44px; height:26px; border-radius:999px;
  background: rgba(255,255,255,.14);
  border:1px solid rgba(255,255,255,.16);
  position:relative;
  cursor:pointer;
  flex:0 0 auto;
}
#chefUpdate .cu-switch::after{
  content:"";
  width:20px; height:20px; border-radius:999px;
  position:absolute; top:2px; left:2px;
  background: rgba(255,255,255,.85);
  transition:.18s ease;
}
#chefUpdate .cu-switch.on{ background: rgba(50,213,131,.25); border-color: rgba(50,213,131,.35); }
#chefUpdate .cu-switch.on::after{ left:22px; background: rgba(255,255,255,.95); }

#chefUpdate .cu-state{
  margin-left:auto;
  padding:7px 10px;
  border-radius:999px;
  font-weight:950;
  font-size:12px;
  border:1px solid rgba(255,255,255,.14);
  background: rgba(255,255,255,.06);
  color: rgba(255,255,255,.80);
}
#chefUpdate .cu-state.ok{ background: rgba(50,213,131,.18); border-color: rgba(50,213,131,.30); color: rgba(214,255,233,.95); }
#chefUpdate .cu-state.off{ background: rgba(255,77,109,.14); border-color: rgba(255,77,109,.25); color: rgba(255,220,227,.92); }

/* Preview */
#chefUpdate .cu-sticky{ position: sticky; top: 18px; align-self:start; }
#chefUpdate .cu-pvHero{ display:flex; justify-content:space-between; gap:12px; align-items:flex-start; }
#chefUpdate .cu-pvName{ margin:0; font-size:18px; font-weight:950; }
#chefUpdate .cu-pvTitle{ margin:6px 0 0 0; color:var(--muted); font-weight:800; font-size:13px; }
#chefUpdate .cu-chip{
  padding:8px 10px;
  border-radius:999px;
  font-weight:900;
  font-size:12px;
  border:1px solid rgba(255,255,255,.14);
  background: rgba(255,255,255,.06);
  color: rgba(255,255,255,.78);
  white-space:nowrap;
  max-width: 100%;
}
#chefUpdate .cu-pvChip{
  padding:8px 12px;
  border-radius:999px;
  font-weight:950;
  font-size:12px;
  border:1px solid rgba(255,255,255,.14);
  background: rgba(255,255,255,.06);
  color: rgba(255,255,255,.80);
  white-space:nowrap;
}
#chefUpdate .cu-pvChip.ok{ background: rgba(50,213,131,.18); border-color: rgba(50,213,131,.30); color: rgba(214,255,233,.95); }
#chefUpdate .cu-pvChip.off{ background: rgba(255,77,109,.14); border-color: rgba(255,77,109,.25); color: rgba(255,220,227,.92); }

#chefUpdate .cu-imgBox{
  margin-top:12px;
  border-radius:18px;
  border:1px solid rgba(255,255,255,.14);
  background: rgba(0,0,0,.22);
  overflow:hidden;
  height:220px;
  display:grid;
  place-items:center;
}
#chefUpdate .cu-imgBox img{ width:100%; height:100%; object-fit:cover; display:block; }
#chefUpdate .cu-noimg{ color: rgba(255,255,255,.55); font-weight:900; text-align:center; padding:16px; }

#chefUpdate .cu-wideBox{
  margin-top:14px;
  border-radius:16px;
  border:1px solid rgba(255,255,255,.14);
  background: rgba(0,0,0,.16);
  padding:12px;
}
#chefUpdate .cu-k{ color: var(--muted2); font-weight:900; font-size:12px; margin:0 0 6px; }
#chefUpdate .cu-v{ margin:0; font-weight:950; font-size:14px; color: rgba(255,255,255,.92); }

#chefUpdate .cu-chipsRow{ display:flex; gap:10px; flex-wrap:wrap; margin-top:10px; }
#chefUpdate .cu-foot{ display:flex; gap:10px; justify-content:space-between; margin-top:14px; flex-wrap:wrap; }
</style>
}

<div id="chefUpdate">
  <div class="cu-grid"></div>
  <div class="cu-orb o1"></div>
  <div class="cu-orb o2"></div>
  <div class="cu-orb o3"></div>

  <div class="cu-head">
    <div style="display:flex; gap:12px; align-items:flex-start;">
      <div class="cu-icon">👨‍🍳</div>
      <div>
        <h1 class="cu-title">Şef • Güncelleme</h1>
        <p class="cu-sub">Mevcut resim + canlı önizleme.</p>
      </div>
    </div>
    <div class="cu-pill">Admin • Update</div>
  </div>

  <div class="cu-layout">

    <div class="cu-card">
      <div class="cu-cardHead">
        <h3 class="cu-cardTitle">Form</h3>
        <div style="display:flex; gap:10px; flex-wrap:wrap;">
          <button type="button" class="cu-btn cu-btnGhost" id="btnClear">🧹 Önizlemeyi Temizle</button>
        </div>
      </div>

      <div class="cu-body">
        <form asp-action="UpdateChef" asp-controller="Chef" method="post" id="chefForm" enctype="multipart/form-data">
          @Html.AntiForgeryToken()
          <div asp-validation-summary="All" class="cu-val"></div>

          @Html.HiddenFor(x => x.ChefId)

          <input type="hidden" id="inCurrentImg" name="ImageFile" value="@currentImg" />

          <div class="cu-field">
            <div class="cu-label"><label>Şef İsmi</label><span class="cu-hint" id="hintName">—</span></div>
            @Html.TextBoxFor(x => x.ChefName, new { @class="cu-input", id="inName", placeholder="Ahmet Yılmaz" })
          </div>

          <div class="cu-field">
            <div class="cu-label"><label>Uzmanlık / Ünvan</label><span class="cu-hint" id="hintTitle">—</span></div>
            @Html.TextBoxFor(x => x.ChefTitle, new { @class="cu-input", id="inTitle", placeholder="Baş Şef" })
          </div>

          <div class="cu-field">
            <div class="cu-label"><label>Açıklama</label><span class="cu-hint">Canlı yansır</span></div>
            @Html.TextAreaFor(x => x.ChefDescription, new { @class="cu-input", id="inDesc", placeholder="20 yıllık deneyime sahip..." })
          </div>

          <div class="cu-row">
            <div class="cu-field">
              <div class="cu-label"><label>Dosya</label><span class="cu-hint">Profil Fotoğraf</span></div>
              <input type="file" class="cu-input" id="inImgFile" name="file" accept="image/*" />
            </div>
          </div>

          <div class="cu-row">
            <div class="cu-field">
              <div class="cu-label"><label>Facebook</label><span class="cu-hint">Opsiyonel</span></div>
              @Html.TextBoxFor(x => x.ChefFacebookUrl, new { @class="cu-input", id="inFb", placeholder="https://facebook.com/..." })
            </div>
            <div class="cu-field">
              <div class="cu-label"><label>Instagram</label><span class="cu-hint">Opsiyonel</span></div>
              @Html.TextBoxFor(x => x.ChefInstagramUrl, new { @class="cu-input", id="inIg", placeholder="https://instagram.com/..." })
            </div>
          </div>

          <div class="cu-row">
            <div class="cu-field">
              <div class="cu-label"><label>LinkedIn</label><span class="cu-hint">Opsiyonel</span></div>
              @Html.TextBoxFor(x => x.ChefLinkedinUrl, new { @class="cu-input", id="inLi", placeholder="https://linkedin.com/in/..." })
            </div>
            <div class="cu-field">
              <div class="cu-label"><label>X (Twitter)</label><span class="cu-hint">Opsiyonel</span></div>
              @Html.TextBoxFor(x => x.ChefXUrl, new { @class="cu-input", id="inX", placeholder="https://x.com/..." })
            </div>
          </div>

          <div class="cu-field">
            <div class="cu-label"><label>Status</label><span class="cu-hint">Aktif / Pasif</span></div>
            <div class="cu-toggle">
              <div class="cu-switch" id="statusSwitch" role="switch" aria-checked="true"></div>
              <b id="statusText" style="font-weight:950">Aktif</b>
              <span class="cu-state ok" id="statusChip">Aktif</span>
              @Html.CheckBoxFor(x => x.ChefStatus, new { id="statusHidden", style="display:none" })
            </div>
          </div>

          <div class="cu-foot">
            <button type="submit" class="cu-btn cu-btnPrimary">✨ Güncelle</button>
            <a asp-action="ChefList" asp-controller="Chef" class="cu-btn">↩️ Vazgeç</a>
          </div>
        </form>
      </div>
    </div>

    <div class="cu-card cu-sticky">
      <div class="cu-cardHead">
        <h3 class="cu-cardTitle">Canlı Önizleme</h3>
        <span class="cu-chip" id="pvStatusChip">Status: -</span>
      </div>

      <div class="cu-body">
        <div class="cu-pvHero">
          <div>
            <p class="cu-pvName" id="pvName">Örn: —</p>
            <p class="cu-pvTitle" id="pvTitle">Uzmanlık / Ünvan</p>
          </div>
          <span class="cu-pvChip ok" id="pvState">Aktif</span>
        </div>

        <div class="cu-imgBox" id="pvImgBox" data-current="@currentImg">
          @if (!string.IsNullOrWhiteSpace(currentImg))
          {
              <img src="@currentImg" alt="Chef" />
          }
          else
          {
              <div class="cu-noimg">Resim önizlemesi burada görünecek.</div>
          }
        </div>

        <div class="cu-wideBox">
          <p class="cu-k">“ Açıklama ”</p>
          <p class="cu-v" id="pvDesc">Şef açıklaması burada görünür.</p>
        </div>

        <div class="cu-chipsRow">
          <span class="cu-chip" id="chipFb">Facebook: -</span>
          <span class="cu-chip" id="chipIg">Instagram: -</span>
          <span class="cu-chip" id="chipLi">LinkedIn: -</span>
          <span class="cu-chip" id="chipX">X: -</span>
        </div>

        <div class="cu-foot" style="margin-top:16px;">
          <button type="button" class="cu-btn cu-btnDanger" id="btnClear2">🧹 Önizlemeyi Temizle</button>
          <span class="cu-pill" style="padding:8px 12px;">Canlı Görünüm</span>
        </div>
      </div>
    </div>

  </div>
</div>

@section Scripts {
<script>
(function () {
  const $ = (id) => document.getElementById(id);

  // inputs
  const inName    = $("inName");
  const inTitle   = $("inTitle");
  const inDesc    = $("inDesc");
  const inImgFile = $("inImgFile");
  const inFb      = $("inFb");
  const inIg      = $("inIg");
  const inLi      = $("inLi");
  const inX       = $("inX");

  // hints
  const hintName  = $("hintName");
  const hintTitle = $("hintTitle");

  // preview nodes
  const pvName   = $("pvName");
  const pvTitle  = $("pvTitle");
  const pvDesc   = $("pvDesc");
  const pvImgBox = $("pvImgBox");

  const chipFb = $("chipFb");
  const chipIg = $("chipIg");
  const chipLi = $("chipLi");
  const chipX  = $("chipX");

  // status
  const statusSwitch  = $("statusSwitch");
  const statusHidden  = $("statusHidden");
  const statusText    = $("statusText");
  const statusChip    = $("statusChip");
  const pvState       = $("pvState");
  const pvStatusChip  = $("pvStatusChip");

  // buttons
  const btnClear  = $("btnClear");
  const btnClear2 = $("btnClear2");

  let lastObjectUrl = null;

  function safeText(v, fallback) {
    const t = (v ?? "").toString().trim();
    return t.length ? t : (fallback ?? "—");
  }

  function shortLink(label, url) {
    const t = (url || "").trim();
    if (!t) return `${label}: -`;
    const max = 28;
    const shown = t.length > max ? (t.slice(0, max) + "…") : t;
    return `${label}: ${shown}`;
  }

  function paintStatus(isOn) {
    statusSwitch?.classList.toggle("on", isOn);
    if (statusText) statusText.textContent = isOn ? "Aktif" : "Pasif";

    if (statusChip) {
      statusChip.classList.toggle("ok", isOn);
      statusChip.classList.toggle("off", !isOn);
      statusChip.textContent = isOn ? "Aktif" : "Pasif";
    }

    if (pvState) {
      pvState.classList.toggle("ok", isOn);
      pvState.classList.toggle("off", !isOn);
      pvState.textContent = isOn ? "Aktif" : "Pasif";
    }

    if (pvStatusChip) pvStatusChip.textContent = `Status: ${isOn ? "Aktif" : "Pasif"}`;
  }

  function setFilePreview() {
    if (!pvImgBox) return;

    // önceki object url'i temizle
    if (lastObjectUrl) {
      URL.revokeObjectURL(lastObjectUrl);
      lastObjectUrl = null;
    }

    const file = inImgFile?.files?.[0];

    // ✅ yeni dosya seçildiyse onu göster
    if (file) {
      const url = URL.createObjectURL(file);
      lastObjectUrl = url;

      pvImgBox.innerHTML = '<img alt="Chef" />';
      const img = pvImgBox.querySelector("img");
      img.onerror = () => {
        pvImgBox.innerHTML = '<div class="cu-noimg">Görsel yüklenemedi.</div>';
      };
      img.src = url;
      return;
    }

    // ✅ dosya yoksa: dataset (API'li) veya hidden (API'li)
    const dataVal   = (pvImgBox.dataset.current || "").trim();
    const hiddenVal = (document.getElementById("inCurrentImg")?.value || "").trim();
    const current   = dataVal || hiddenVal;

    if (current) {
      pvImgBox.innerHTML = `<img alt="Chef" src="${current}" />`;
      return;
    }

    pvImgBox.innerHTML = '<div class="cu-noimg">Resim önizlemesi burada görünecek.</div>';
  }

  function updatePreview() {
    const name  = safeText(inName?.value, "—");
    const title = safeText(inTitle?.value, "Uzmanlık / Ünvan");
    const desc  = safeText(inDesc?.value, "Şef açıklaması burada görünür.");

    if (pvName)  pvName.textContent  = `Örn: ${name}`;
    if (pvTitle) pvTitle.textContent = title;
    if (pvDesc)  pvDesc.textContent  = desc;

    if (hintName)  hintName.textContent  = (name === "—") ? "—" : "Hazır";
    if (hintTitle) hintTitle.textContent = (title === "Uzmanlık / Ünvan") ? "—" : "Hazır";

    if (chipFb) chipFb.textContent = shortLink("Facebook", inFb?.value);
    if (chipIg) chipIg.textContent = shortLink("Instagram", inIg?.value);
    if (chipLi) chipLi.textContent = shortLink("LinkedIn", inLi?.value);
    if (chipX)  chipX.textContent  = shortLink("X", inX?.value);

    setFilePreview();
    paintStatus(!!statusHidden?.checked);
  }

  // status toggle click
  statusSwitch?.addEventListener("click", () => {
    if (!statusHidden) return;
    statusHidden.checked = !statusHidden.checked;
    updatePreview();
  });

  // live binds
  [inName, inTitle, inDesc, inFb, inIg, inLi, inX].forEach(inp => {
    inp?.addEventListener("input", updatePreview);
    inp?.addEventListener("change", updatePreview);
  });

  // file change
  inImgFile?.addEventListener("change", updatePreview);

  function clearAll() {
    if (inName)  inName.value = "";
    if (inTitle) inTitle.value = "";
    if (inDesc)  inDesc.value = "";
    if (inFb)    inFb.value = "";
    if (inIg)    inIg.value = "";
    if (inLi)    inLi.value = "";
    if (inX)     inX.value = "";

    if (inImgFile) inImgFile.value = "";
    if (statusHidden) statusHidden.checked = false;

    updatePreview();
  }

  btnClear?.addEventListener("click", clearAll);
  btnClear2?.addEventListener("click", clearAll);

  // init
  updatePreview();
})();
</script>
}
